# HTML cleanup removes ad containers that would otherwise leave oversized blank boxes.
^https?:\/\/91porn\.com\/(?:v|view_video)\.php(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/biu1biu/qx-rewrite/main/scripts/91porn-cleanup.js

# Confirmed ad resources from the supplied HAR. Do not block la.btc620.com video requests.
^https?:\/\/poweredby\.jads\.co\/adshow\.php(?:\?.*)?$ url reject
^https?:\/\/go\.rmhfrtnd\.com\/smartpop\/.* url reject
^https?:\/\/i\.jads\.co\/(?:ads|network)\/.* url reject
^https?:\/\/creative\.9splt\.com\/(?:widgets|static)\/.* url reject
^https?:\/\/go\.9splt\.com\/(?:config|api|app|abc\.gif)(?:[\/?].*)?$ url reject
^https?:\/\/t\.nettrck\.store\/s1\/.* url reject
^https?:\/\/static\.javhdhello\.com\/h5\/files\/\d+\/300x250\.html(?:\?.*)?$ url reject
^https?:\/\/fans\.91selfie\.com\/fans\/.*\.(?:gif|png|jpg)(?:\?.*)?$ url reject

hostname = 91porn.com, poweredby.jads.co, go.rmhfrtnd.com, i.jads.co, creative.9splt.com, go.9splt.com, t.nettrck.store, static.javhdhello.com, fans.91selfie.com
